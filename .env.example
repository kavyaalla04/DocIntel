# Server Configuration
APP_NAME="Document Intelligence Platform"
DEBUG=False
HOST=0.0.0.0
PORT=3000
RELOAD=False

# Database
MONGODB_URL=mongodb://admin:admin123@localhost:27017
MONGODB_DB=document-intelligence

# Redis
REDIS_URL=redis://localhost:6379

# Managed OpenAI-compatible gateway (gateway selects its own model)
OPENROUTER_BASE_URL=https://keygateway1.arshnivlabs.com/v1
OPENROUTER_API_KEY=YOUR_ASSIGNED_LAB_CREDENTIAL

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# File Upload
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO

# Organization Defaults
DEFAULT_ORGANIZATION_ID=org_default
DEFAULT_USER_ID=user_default

# Budget
DEFAULT_MONTHLY_BUDGET=100.0

# Processing
DOCUMENT_RETENTION_DAYS=90
